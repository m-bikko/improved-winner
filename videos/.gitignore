# Что из проектов роликов НЕ коммитим.

# Подложка приходит из музыкальной библиотеки HeyGen. Она лицензирована
# для использования внутри ролика, а не для раздачи файлом - репозиторий
# публичный, и класть туда чужой трек нельзя. Ролик собирается заново
# командой из README проекта.
*/assets/bgm/

# Снимки экранов в assets/ - это копии из capture/, которые раскладывает
# stage-assets.mjs (и повторно assemble-index.mjs). Хранить оба набора значит
# держать в репозитории одни и те же три мегабайта дважды. Источник - capture/.
*/assets/*.png
*/assets/*.svg

# Готовое видео и промежуточные кадры рендера - многие мегабайты,
# воспроизводятся из исходников
*/renders/
*/snapshots/
*/.hyperframes/preview*
*/node_modules/

# Служебное состояние прогона
*/audio_engine_meta.json
*/audio_request.json

# Пакеты для исполнителей кадров - целиком производные: их собирает
# frame-packets.mjs из STORYBOARD.md и текстов скиллов
*/.hyperframes/frame-packets/

# Миниатюры таймлайна, которые пишет просмотрщик hyperframes
*/.thumbnails/
