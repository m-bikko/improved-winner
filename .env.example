# Клиентские переменные - Vite экспортирует в бандл всё с префиксом VITE_.
# Все VITE_-переменные нужны и здесь, и в переменных Vercel: читаются ПРИ СБОРКЕ.

# Название приложения. Пусто - «Тандем». Заголовок страницы, манифест PWA, шапка.
# Переименование требует пересборки, а на телефоне - удалить и заново добавить
# иконку на экран «Домой»: iOS запоминает имя в момент установки.
VITE_PUBLIC_APP_NAME="Тандем"
# Короткое имя для подписи под иконкой. Пусто - совпадает с полным.
VITE_PUBLIC_APP_SHORT_NAME="Тандем"

# Имена пары на экране входа и в профилях. Пусто - имена по умолчанию из src/lib/accounts.ts.
VITE_PUBLIC_PARTNER_1_NAME=""
VITE_PUBLIC_PARTNER_2_NAME=""

VITE_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Серверные - без префикса VITE_, в браузер не попадают. Локально их читают скрипты
# из scripts/, а на Vercel - только функция отправки push (api/push.ts).
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."

# Session-mode пулер (порт 5432). Транзакционный на 6543 не подходит для миграций.
POSTGRES_URL_NON_POOLING="postgres://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# PIN-коды - ровно 6 цифр: BIKOSH - первого из пары, AMINOSH - второго.
# Имена переменных остались от первой пары. Читают pnpm couple и pnpm bootstrap.
# В клиентский бандл не попадают: вход проверяет их на стороне Supabase Auth.
LOVE_PIN_BIKOSH="000000"
LOVE_PIN_AMINOSH="000000"

# Часовой пояс и язык каждого (ru, kk или en). Читает только pnpm couple.
# Пояс в интерфейсе не меняется, а по нему база решает, когда слать напоминания.
PARTNER_1_TIMEZONE="Asia/Almaty"
PARTNER_1_LANGUAGE="ru"
PARTNER_2_TIMEZONE="Asia/Almaty"
PARTNER_2_LANGUAGE="ru"

# Push-уведомления. Ключи VAPID: npx web-push generate-vapid-keys.
# VITE_PUBLIC_VAPID_KEY - публичный, остальные три - только Vercel и этот файл.
VITE_PUBLIC_VAPID_KEY=""
VAPID_PRIVATE_KEY=""
# Адрес сайта (https://<домен>) или mailto: - так сервис push знает, с кем связаться.
VAPID_SUBJECT=""
# Общий секрет базы и функции push: openssl rand -hex 32. Нужен и здесь, и на Vercel.
PUSH_SHARED_SECRET=""
# Адрес функции после деплоя, вида https://<домен>/api/push. Его и секрет в базу кладёт pnpm secrets.
PUSH_ENDPOINT_URL=""

# Необязательно: токен Telegram-бота от @BotFather. В базу его кладёт pnpm secrets.
TELEGRAM_BOT_ID=""
